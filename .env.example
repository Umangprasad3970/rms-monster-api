# ============================================================================
# NEOSERVE PROJECTS — ENTERPRISE API CONFIGURATION (.env)
# ============================================================================

# 1. Server Configuration
PORT=5000
FLASK_ENV=development

# 2. MySQL Database Configuration
# Set your MySQL server credentials below (works with XAMPP, MySQL Workbench, Docker, or Cloud MySQL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=neoserve_db

# Or use connection URL:
# MYSQL_URL=mysql://root:yourpassword@localhost:3306/neoserve_db

# 3. Optional PostgreSQL Fallback
# DATABASE_URL=postgresql://postgres:password@localhost:5432/neoserve_db

# 4. SMTP Email Notification Service (Contact Us, Lead Capture & Site Audits)
# For Gmail, generate an 'App Password' from myaccount.google.com -> Security -> App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=umangprasad3970@gmail.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=umangprasad3970@gmail.com
NOTIFICATION_EMAIL_TO=umangprasad3970@gmail.com
SMTP_USE_TLS=true
